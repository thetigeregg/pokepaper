{
  "name": "pokepaper",
  "version": "0.34.2",
  "private": true,
  "description": "PokePaper: Pokémon TCG card browser, collection tracker, and deck builder",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deps:angular:update": "ng update @angular/core @angular/cli @angular/cdk",
    "deps:angular:ecosystem": "ng update angular-eslint",
    "typecheck:server": "npm run typecheck --workspace server",
    "test:server": "vitest run --project server",
    "start:server": "npm run dev --workspace server",
    "generate:ios-info-plists": "node scripts/generate-ios-info-plists.mjs",
    "sync:ios:version": "node scripts/sync-ios-version.mjs",
    "prebuild:ios": "node scripts/sync-ios-version.mjs --marketing-only && node scripts/generate-ios-info-plists.mjs",
    "prebuild:ios:local": "node scripts/write-environment-ios.mjs local && npm run prebuild:ios",
    "prebuild:ios:prod": "node scripts/write-environment-ios.mjs prod && npm run prebuild:ios",
    "build:ios:local": "ng build --configuration ios-local",
    "build:ios:prod": "ng build --configuration ios-prod",
    "sync:ios:local": "npm run build:ios:local && npx cap sync ios",
    "sync:ios:prod": "npm run build:ios:prod && npx cap sync ios"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.8",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@capacitor/cli": "^8.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ionic/angular-toolkit": "^13.0.0",
    "@thetigeregg/commitlint-config": "^2.0.3",
    "@thetigeregg/dev-cli": "^5.1.0",
    "@thetigeregg/lint-staged-config": "^2.0.0",
    "@thetigeregg/ncu-config": "^3.1.0",
    "@thetigeregg/prettier-config": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.16.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "npm-check-updates": "^23.1.1",
    "plist": "^5.1.2",
    "prettier": "^3.10.1",
    "sql.js": "^1.17.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome/capacitor-live-update": "^8.8.2",
    "@capgo/capacitor-passkey": "^8.5.10",
    "@ionic/angular": "^9.0.13",
    "@pokepaper/shared": "^0.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "capacitor-secure-storage-plugin": "^0.14.2",
    "dexie": "^4.4.7",
    "ionicons": "^8.1.1",
    "rxjs": "~7.8.2",
    "swiper": "^14.4.0",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  }
}
