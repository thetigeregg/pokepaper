# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt

/.sourcemaps
/.versions
/coverage

# Ionic
/.ionic
/www
/platforms
/plugins

# iOS environment layering (scripts/write-environment-ios.mjs generates these
# just before an ios-local/ios-prod build; see .env.example)
/src/environments/environment.ios.local.ts
/src/environments/environment.ios.prod.ts
/.env

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node (unanchored so this also matches npm workspace packages'
# node_modules, e.g. shared/node_modules, server/node_modules)
node_modules/
npm-debug.log
yarn-error.log

# Server SQLite database, image cache, and backups: real user data, never
# committed (the server creates these directories on startup)
server/data/*
!server/data/.gitkeep
server/backups/*
!server/backups/.gitkeep

# docker-compose.yml's default bind-mount targets (NAS_DATA_ROOT /
# SECRETS_HOST_DIR defaults): local-only when running the compose stack from
# a repo checkout. nas-secrets holds e.g. setup_token, never committed.
/nas-data
/nas-secrets

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Claude Code local settings and devx outputs
.claude/settings.json
.claude/settings.local.json
/worktrees/
prompts/
